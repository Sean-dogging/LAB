class Field:
    """Label + Entry with placeholder, colored border and message line."""

    def __init__(self, parent, caption, var, placeholder, hint):
        self.var = var
        self.hint = hint
        self.state = "neutral"

        tk.Label(
            parent,
            text=caption,
            font=F_LABEL,
            bg=CARD,
            fg=FG
        ).pack(anchor="w")

        self.border = tk.Frame(parent, bg=BORDER, padx=2, pady=2)
        self.border.pack(fill="x", pady=(3, 0))

        self.entry = tk.Entry(
            self.border,
            textvariable=var,
            font=F_ENTRY,
            bg="white",
            fg=FG,
            insertbackground=PINK_DARK,
            relief="flat",
            bd=0,
            highlightthickness=0
        )
        self.entry.pack(fill="x", ipady=7)

        self.ph = tk.Label(
            self.entry,
            text=placeholder,
            font=F_ENTRY,
            bg="white",
            fg="#94A3B8"
        )
        self.ph.place(x=8, rely=0.5, anchor="w")
        self.ph.bind("<Button-1>", lambda e: self.entry.focus_set())

        self.msg = tk.Label(
            parent,
            text=hint,
            font=F_MSG,
            bg=CARD,
            fg=MUTED,
            anchor="w",
            justify="left"
        )
        self.msg.pack(fill="x", pady=(2, 8))

        self.entry.bind("<FocusIn>", self._focus_in)
        self.entry.bind("<FocusOut>", self._focus_out)

    def _focus_in(self, event=None):
        if self.state == "neutral":
            self.border.config(bg=PINK)

    def _focus_out(self, event=None):
        if self.state == "neutral":
            self.border.config(bg=BORDER)

    def refresh_placeholder(self):
        if self.var.get():
            self.ph.place_forget()
        else:
            self.ph.place(x=8, rely=0.5, anchor="w")

    def show(self, ok, message):
        self.state = "ok" if ok else "bad"
        color = GREEN if ok else RED
        icon = "\u2714 " if ok else "\u2716 "
        self.msg.config(text=icon + message, fg=color)
        self.border.config(bg=color)

    def reset(self):
        self.state = "neutral"
        self.msg.config(text=self.hint, fg=MUTED)
        self.border.config(bg=BORDER)
        self.refresh_placeholder()


