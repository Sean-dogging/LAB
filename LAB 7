# ---- Log field values when focus leaves the field ---------------------
def _log_field(label, raw, checker, accepted_word, rejected_word):
    ok, _, msg = checker(raw)
    shown = raw if raw.strip() else "(empty)"

    log_trace(
        f"{label}: {shown}",
        accepted_word if ok else rejected_word,
        msg,
        ok
    )


