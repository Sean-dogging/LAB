# ---- Inventory table ---------------------------------------------------
COLUMNS = {
    "no": ("No.", "id"),
    "name": ("Product Name", "name"),
    "qty": ("Qty", "qty"),
    "price": ("Unit Price", "price"),
    "total": ("Total Value", "total")
}


def update_stats():
    stat_products.config(text=str(len(records)))
    stat_qty.config(text=f"{sum(r['qty'] for r in records):,}")
    stat_value.config(text=peso(sum(r["total"] for r in records)))


def refresh_table():
    query = search_var.get().strip().lower()
    rows = [r for r in records if query in r["name"].lower()]

    if sort_col:
        key = COLUMNS[sort_col][1]
        rows.sort(
            key=lambda r: r[key].lower() if isinstance(r[key], str) else r[key],
            reverse=sort_reverse
        )

    tree.delete(*tree.get_children())

    for i, r in enumerate(rows):
        tree.insert(
            "",
            "end",
            iid=str(r["id"]),
            values=(
                r["id"],
                r["name"],
                r["qty"],
                peso(r["price"]),
                peso(r["total"])
            ),
            tags=("odd" if i % 2 else "even",)
        )

    for col, (text, _) in COLUMNS.items():
        arrow = ""
        if col == sort_col:
            arrow = "  \u25bc" if sort_reverse else "  \u25b2"
        tree.heading(col, text=text + arrow)

    update_stats()


def sort_by(col):
    global sort_col, sort_reverse

    if sort_col == col:
        sort_reverse = not sort_reverse
    else:
        sort_col, sort_reverse = col, False

    refresh_table()


# ---- Submit product ----------------------------------------------------
def submit_product():
    """Validate all fields and add the product to inventory."""
    global next_id

    raw_name = name_var.get()
    raw_qty = quantity_var.get()
    raw_price = price_var.get()

    summary = (
        f"Submit: {raw_name or '(empty)'} / "
        f"{raw_qty or '(empty)'} / {raw_price or '(empty)'}"
    )

    name_ok, name, name_m = check_name(raw_name)
    qty_ok, quantity, qty_m = check_quantity(raw_qty)
    price_ok, price, price_m = check_price(raw_price)

    errors = []

    if not name_ok:
        errors.append(f"Product Name: {name_m}")
    if not qty_ok:
        errors.append(f"Quantity: {qty_m}")
    if not price_ok:
        errors.append(f"Unit Price: {price_m}")

    if errors:
        name_field.show(name_ok, name_m)
        quantity_field.show(qty_ok, qty_m)
        price_field.show(price_ok, price_m)
        refresh_form_status()

        log_trace(summary, "Rejected", " ; ".join(errors), False)
        set_footer("Submission rejected.")

        messagebox.showerror(
            "Invalid Input",
            "Please correct the following:\n\n" + "\n".join(errors)
        )
        return

    try:
        total = quantity * price
    except (TypeError, OverflowError):
        messagebox.showerror(
            "Error",
            "Could not compute the total value."
        )
        return

    record = {
        "id": next_id,
        "name": name,
        "qty": quantity,
        "price": price,
        "total": total
    }

    next_id += 1
    records.append(record)
    refresh_table()

    if tree.exists(str(record["id"])):
        tree.see(str(record["id"]))

    last_body.config(
        text=(
            f"Product Name: {name}\n"
            f"Quantity: {quantity}\n"
            f"Unit Price: {peso(price)}\n"
            f"Total Value: {peso(total)}"
        ),
        fg=FG
    )

    last_status.config(
        text="Status: Successfully Added",
        fg=GREEN
    )

    log_trace(
        summary,
        "Product added",
        f"Successfully Added (Total {peso(total)})",
        True
    )

    set_footer(f"Added '{name}'.")
    messagebox.showinfo(
        "Success",
        f"'{name}' was successfully added to the inventory."
    )

    clear_form(log=False)
    status_label.config(
        text="\u2714 Product added successfully.",
        fg=GREEN
    )


# ---- Clear form --------------------------------------------------------
def clear_form(log=True):
    """Empty fields and reset messages without deleting inventory."""
    global suppress

    suppress = True
    name_var.set("")
    quantity_var.set("")
    price_var.set("")
    suppress = False

    for field in (name_field, quantity_field, price_field):
        field.reset()

    refresh_form_status()
    name_field.entry.focus_set()

    if log:
        log_trace(
            "Click Clear Form",
            "Fields reset",
            "All fields emptied, messages reset",
            True
        )
        set_footer("Form cleared.")


# ---- Inventory actions -------------------------------------------------
def delete_selected(event=None):
    selected = tree.selection()

    if not selected:
        messagebox.showinfo(
            "Delete Selected",
            "Select a product row first."
        )
        return

    if messagebox.askyesno(
        "Delete Selected",
        f"Delete {len(selected)} selected record(s)?"
    ):
        ids = {int(i) for i in selected}
        records[:] = [r for r in records if r["id"] not in ids]

        refresh_table()
        log_trace(
            "Delete selected rows",
            "Records removed",
            f"{len(ids)} record(s) deleted",
            True
        )
        set_footer("Selected records deleted.")


def clear_inventory():
    if not records:
        messagebox.showinfo(
            "Clear Inventory",
            "There are no records to clear."
        )
        return

    if messagebox.askyesno(
        "Clear Inventory",
        "Delete ALL submitted inventory records?"
    ):
        records.clear()
        refresh_table()
        last_body.config(text="No product added yet.", fg=MUTED)
        last_status.config(text="")

        log_trace(
            "Click Clear Inventory",
            "Records removed",
            "Inventory output cleared",
            True
        )
        set_footer("Inventory cleared.")


def export_csv(event=None):
    if not records:
        messagebox.showinfo(
            "Export CSV",
            "There are no records to export."
        )
        return

    path = filedialog.asksaveasfilename(
        defaultextension=".csv",
        filetypes=[("CSV files", "*.csv")],
        initialfile="inventory_export.csv"
    )

    if not path:
        return

    try:
        with open(path, "w", newline="", encoding="utf-8-sig") as f:
            writer = csv.writer(f)
            writer.writerow([
                "No.", "Product Name", "Quantity",
                "Unit Price", "Total Value"
            ])

            for r in records:
                writer.writerow([
                    r["id"],
                    r["name"],
                    r["qty"],
                    f"{r['price']:.2f}",
                    f"{r['total']:.2f}"
                ])

    except OSError as err:
        messagebox.showerror(
            "Export Failed",
            f"Could not save file:\n{err}"
        )
        return

    log_trace("Export CSV", "File saved", path, True)
    set_footer("Inventory exported to CSV.")

    messagebox.showinfo(
        "Export CSV",
        "Inventory exported successfully."
    )


def save_log():
    content = log_text.get("1.0", "end").strip()

    if not content:
        messagebox.showinfo(
            "Save Log",
            "The trace log is empty."
        )
        return

    path = filedialog.asksaveasfilename(
        defaultextension=".txt",
        filetypes=[("Text files", "*.txt")],
        initialfile="Validation_Trace_Log.txt"
    )

    if not path:
        return

    try:
        with open(path, "w", encoding="utf-8") as f:
            f.write(
                "Test input | Expected response | Actual response\n"
            )
            f.write(content + "\n")

    except OSError as err:
        messagebox.showerror(
            "Save Failed",
            f"Could not save file:\n{err}"
        )
        return

    set_footer("Trace log saved.")


def clear_log():
