def set_footer(text):
    footer_status.config(text=text)


def log_trace(test_input, expected, actual, ok=True):
    """Append one line to the Validation Trace Log."""
    stamp = datetime.now().strftime("%H:%M:%S")
    log_text.config(state="normal")
    log_text.insert("end", f"[{stamp}] ", "time")
    log_text.insert(
        "end",
        f"{test_input} | {expected} | {actual}\n",
        "ok" if ok else "bad"
    )
    log_text.see("end")
    log_text.config(state="disabled")


def refresh_form_status(*args):
    """Update validation status, progress bar and live total."""
    n_ok, name, _ = check_name(name_var.get())
    q_ok, qty, _ = check_quantity(quantity_var.get())
    p_ok, price, _ = check_price(price_var.get())

    valid_count = sum((n_ok, q_ok, p_ok))

    progress["value"] = valid_count / 3 * 100
    progress_label.config(text=f"{valid_count}/3 fields valid")

    if q_ok and p_ok:
        total_preview.config(
            text=f"Live total preview:  {peso(qty * price)}",
            fg=PINK_DARK
        )
    else:
        total_preview.config(text="Live total preview:  --", fg=MUTED)

    any_input = name_var.get() or quantity_var.get() or price_var.get()

    if not any_input:
        status_label.config(
            text="Show current form status here.",
            fg=MUTED
        )
    elif valid_count == 3:
        status_label.config(
            text="\u2714 Form is valid. You may click Submit Product.",
            fg=GREEN
        )
    else:
        problems = []

        if not n_ok:
            problems.append("Product Name")
        if not q_ok:
            problems.append("Quantity")
        if not p_ok:
            problems.append("Unit Price")

        status_label.config(
            text="\u2716 Please fix: " + ", ".join(problems) + ".",
            fg=RED
        )


